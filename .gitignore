# Secrets / local configuration
.env
.env.*
!.env.example
*.pem
*.key

# User-customized prompts (may contain private instructions)
/config/system_prompt.txt

# Uploaded PDFs, extracted text, analyses, SQLite / personal content
/data/
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.pdf

# Python and test files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Local / editor / backup artifacts
/local/
.DS_Store
.vscode/
.idea/
*.log
*.bak
*.bak-*
*.swp

# Personal notes, guides and test documents: keep them in local/
/local/

# Windows download markers, created when files are copied into WSL
*:Zone.Identifier
