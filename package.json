{
  "name": "llama-cpp-document-processor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/test_polling.js",
    "format:check": "prettier --check \"static/**/*.js\" \"static/**/*.css\" \"templates/**/*.html\" \"tests/**/*.js\" package.json .prettierrc.json",
    "format": "prettier --write \"static/**/*.js\" \"static/**/*.css\" \"templates/**/*.html\" \"tests/**/*.js\" package.json .prettierrc.json"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
