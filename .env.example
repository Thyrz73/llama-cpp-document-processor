# Copy this file to .env and customize it. Never commit .env.

# llama.cpp HTTP API URL. Default works if llama.cpp publishes port 8080
# on the Docker host and listens on the Docker host's gateway address.
# If llama.cpp is bound to a specific LAN IP, use that IP instead.
LLAMA_BASE_URL=http://host.docker.internal:8080
# Optional. Leave empty when the llama.cpp server does not require a key.
LLAMA_API_KEY=

# Bind to loopback by default. Use a LAN interface IP for access from devices
# on your trusted network, e.g. BIND_ADDRESS=192.0.2.10.
BIND_ADDRESS=127.0.0.1
APP_PORT=9932

# Files in ./data must be writable by this UID/GID (id -u / id -g).
PUID=1000
PGID=1000

# Application ceiling: stay at or below the engine context per request/slot.
# This does NOT resize llama.cpp's KV cache or change --ctx-size.
CONTEXT_TOKENS=16384
CHUNK_TOKENS=3000
ANALYSIS_TOKENS=1000
MERGE_TOKENS=1200
FINAL_TOKENS=1800
OUTPUT_LANGUAGE=auto

# Processing limits: tune to the host, not the model.
PROCESSOR_MEMORY_LIMIT=512m
PROCESSOR_CPUS=0.75
MAX_PAGES=120
MAX_UPLOAD_MB=20
REQUEST_TIMEOUT_SECONDS=21600
# An actual per-generation wall-clock deadline, including a silent prefill.
STEP_TIMEOUT_SECONDS=21600
MAX_MODEL_CALLS=500
MAX_JOB_ATTEMPTS=10

# Enable these only after verifying the running llama.cpp build/template.
# No application setting restarts or reconfigures the external engine.
LLAMA_USAGE_SUPPORTED=false
LLAMA_APPLY_TEMPLATE_SUPPORTED=false
# unsupported | chat_template | prompt. The latter uses /think and /no_think.
LLAMA_THINKING_ADAPTER=unsupported
# true only when the template opens <think> without returning that opening tag.
LLAMA_INITIAL_THINKING=false

# Only pages without a usable text layer are OCR'd.
OCR_ENABLED=true
OCR_LANGUAGES=eng+fra
OCR_DPI=150
OCR_MAX_PIXELS=5000000
OCR_TIMEOUT_SECONDS=180

# Optional bounded live generation preview (stored on disk during each pass).
LIVE_OUTPUT_ENABLED=true
LIVE_PREVIEW_CHARS=12000
